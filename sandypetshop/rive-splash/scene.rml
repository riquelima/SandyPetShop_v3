            </KeyedObject>
        </LinearAnimation>

        <!-- Orbit Rotation: 0 -> 2pi (propertyKey 15 = rotation) -->
        <LinearAnimation loopValue="loop" duration="180" name="OrbitSpin" id="0:61">
            <KeyedObject objectId="0:45">
