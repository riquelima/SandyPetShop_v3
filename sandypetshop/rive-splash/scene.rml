                    <KeyFrameDouble value="0.94" interpolationType="linear"/>
                    <KeyFrameDouble value="1.08" interpolationType="linear" frame="60"/>
                    <KeyFrameDouble value="0.94" interpolationType="linear" frame="120"/>
