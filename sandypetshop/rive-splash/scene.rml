        <!-- 7. ANIMATIONS -->
        <!-- Float & Pulse Central Paw and Glow -->
        <LinearAnimation loopValue="loop" duration="120" name="FloatPaw" id="0:60">
            <!-- Float PawGroup Y: 200 -> 188 -> 200 (propertyKey 14 = y) -->
            <KeyedObject objectId="0:30">
                <KeyedProperty propertyKey="14">
                    <KeyFrameDouble value="200" interpolationType="linear"/>
                    <KeyFrameDouble value="188" interpolationType="linear" frame="60"/>
                    <KeyFrameDouble value="200" interpolationType="linear" frame="120"/>
                </KeyedProperty>
                <!-- Scale PawGroup: 1.0 -> 1.05 -> 1.0 (propertyKey 16 = scaleX, 17 = scaleY) -->
                <KeyedProperty propertyKey="16">
                    <KeyFrameDouble value="1" interpolationType="linear"/>
                    <KeyFrameDouble value="1.05" interpolationType="linear" frame="60"/>
                    <KeyFrameDouble value="1" interpolationType="linear" frame="120"/>
                </KeyedProperty>
                <KeyedProperty propertyKey="17">
